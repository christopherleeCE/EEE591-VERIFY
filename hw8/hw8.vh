//cx_cs_rw_add cov
//extended register testing to meet coverage
//uses modify macros the dont clear the byte_enable inbetween write and read
for(int be = 0; be < 4; be++) begin
    `CHECK_RW2(VCHIP_VER_ADDR, 16'h0000, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_VER_ADDR, 16'h5555, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_VER_ADDR, 16'hAAAA, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_VER_ADDR, 16'hFFFF, 16'h0000, be, 1'b0)

    `CHECK_RW2(VCHIP_STA_ADDR, 16'h0000, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_STA_ADDR, 16'h5555, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_STA_ADDR, 16'hAAAA, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_STA_ADDR, 16'hFFFF, 16'h0000, be, 1'b0)

    `CHECK_RW2(VCHIP_CMD_ADDR, 16'h0000, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_CMD_ADDR, 16'h5555, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_CMD_ADDR, 16'hAAAA, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_CMD_ADDR, 16'hFFFF, 16'h0000, be, 1'b0)

    `CHECK_RW2(VCHIP_CON_ADDR, 16'h0000, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_CON_ADDR, 16'h5555, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_CON_ADDR, 16'hAAAA, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_CON_ADDR, 16'hFFFF, 16'h0000, be, 1'b0)

    `CHECK_RW2(VCHIP_ALU_LEFT_ADDR, 16'h0000, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_ALU_LEFT_ADDR, 16'h5555, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_ALU_LEFT_ADDR, 16'hAAAA, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_ALU_LEFT_ADDR, 16'hFFFF, 16'h0000, be, 1'b0)

    `CHECK_RW2(VCHIP_ALU_RIGHT_ADDR, 16'h0000, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_ALU_RIGHT_ADDR, 16'h5555, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_ALU_RIGHT_ADDR, 16'hAAAA, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_ALU_RIGHT_ADDR, 16'hFFFF, 16'h0000, be, 1'b0)

    `CHECK_RW2(VCHIP_ALU_OUT_ADDR, 16'h0000, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_ALU_OUT_ADDR, 16'h5555, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_ALU_OUT_ADDR, 16'hAAAA, 16'h0000, be, 1'b0)
    `CHECK_RW2(VCHIP_ALU_OUT_ADDR, 16'hFFFF, 16'h0000, be, 1'b0)
end

